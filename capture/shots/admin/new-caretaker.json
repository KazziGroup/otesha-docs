{
  "app": "admin-panel",
  "page": "admin/new-caretaker",
  "figures": [
    {
      "id": "admin-new-caretaker-01-en",
      "title": "Registering a caretaker",
      "steps": [
        {
          "goto": "/login"
        },
        {
          "wait": "input[name=email]"
        },
        {
          "fill": [
            "input[name=email]",
            "admin@otesha.co.tz"
          ]
        },
        {
          "fill": [
            "input[name=password]",
            "otesha-dev-2026"
          ]
        },
        {
          "click": "button[type=submit]"
        },
        {
          "wait": "nav"
        },
        {
          "goto": "/caretakers"
        },
        {
          "wait": "table"
        },
        {
          "click": "button:has-text('New caretaker')"
        },
        {
          "wait": "[role=dialog]"
        },
        {
          "park": true
        },
        {
          "pause": 1200
        }
      ],
      "callouts": [
        {
          "sel": "input[name=phone]",
          "note": "The number they sign in with. Written any way; it is the same number.",
          "side": "left"
        },
        {
          "text": "Yes, enrol them now",
          "note": "Active immediately, and you are recorded as the approver.",
          "side": "right"
        }
      ]
    }
  ]
}
