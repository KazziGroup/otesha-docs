{
  "app": "admin-panel",
  "page": "admin/release-payout",
  "note": "Compiles its own run rather than relying on the seeded one being unapproved. A capture that depends on shared state breaks the moment anybody advances it \u2014 and the seeded run was advanced by a stray click during this very module. Compiling is safe to repeat: it works out what is owed and pays nothing.",
  "figures": [
    {
      "id": "admin-release-payout-01-en",
      "title": "Compiling a run",
      "steps": [
        {
          "goto": "/login"
        },
        {
          "wait": "input[name=email]"
        },
        {
          "fill": [
            "input[name=email]",
            "admin@otesha.co.tz"
          ]
        },
        {
          "fill": [
            "input[name=password]",
            "otesha-dev-2026"
          ]
        },
        {
          "click": "button[type=submit]"
        },
        {
          "wait": "nav"
        },
        {
          "goto": "/payouts"
        },
        {
          "wait": "text=Compile a run"
        },
        {
          "park": true
        },
        {
          "pause": 1200
        }
      ],
      "callouts": [
        {
          "text": "Nothing is paid yet",
          "note": "Compiling only works out what is owed.",
          "side": "left"
        },
        {
          "text": "Compile a run",
          "note": "Reads the rates in force and sums the work in the period.",
          "side": "right"
        }
      ]
    },
    {
      "id": "admin-release-payout-02-en",
      "title": "Approving a run",
      "steps": [
        {
          "goto": "/login"
        },
        {
          "wait": "input[name=email]"
        },
        {
          "fill": [
            "input[name=email]",
            "admin@otesha.co.tz"
          ]
        },
        {
          "fill": [
            "input[name=password]",
            "otesha-dev-2026"
          ]
        },
        {
          "click": "button[type=submit]"
        },
        {
          "wait": "nav"
        },
        {
          "goto": "/payouts"
        },
        {
          "wait": "text=Compile a run"
        },
        {
          "click": "a[href*='/payouts/']"
        },
        {
          "wait": "text=Gross"
        },
        {
          "park": true
        },
        {
          "pause": 1200
        }
      ],
      "callouts": [
        {
          "text": "Gross",
          "note": "What the work came to before anything was held.",
          "side": "left"
        },
        {
          "text": "Net",
          "note": "What will actually be disbursed.",
          "side": "right"
        }
      ]
    }
  ]
}
