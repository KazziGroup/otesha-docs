{
  "app": "customer-app",
  "page": "customer/sign-in",
  "figures": [
    {
      "id": "customer-sign-in-01-en",
      "title": "The sign-in screen",
      "steps": [
        {
          "goto": "/login"
        },
        {
          "wait": "button[type=submit]"
        },
        {
          "fill": [
            "input[type=tel]",
            "0712 345 678"
          ]
        },
        {
          "pause": 400
        }
      ],
      "callouts": [
        {
          "sel": "input[type=tel]",
          "note": "Your phone number, starting 07.",
          "side": "left"
        },
        {
          "sel": "button[type=submit]",
          "note": "Sends a six-digit code by SMS.",
          "side": "right"
        }
      ]
    },
    {
      "id": "customer-sign-in-02-en",
      "title": "The code screen",
      "steps": [
        {
          "goto": "/login"
        },
        {
          "wait": "input[type=tel]"
        },
        {
          "fill": [
            "input[type=tel]",
            "0700 000 012"
          ]
        },
        {
          "click": "button[type=submit]"
        },
        {
          "wait": "input[name=code]"
        },
        {
          "fill": [
            "input[name=code]",
            "237809"
          ]
        },
        {
          "hide": "p.font-mono"
        },
        {
          "pause": 400
        }
      ],
      "callouts": [
        {
          "sel": "input[name=code]",
          "note": "The six digits from the SMS.",
          "side": "left"
        },
        {
          "sel": "button[type=submit]",
          "note": "Signs you in.",
          "side": "right"
        }
      ],
      "note": "`hide` removes the mock-SMS debug panel: it exists only because SMS_PROVIDER=mock locally, and a reader would never see it."
    },
    {
      "id": "customer-sign-in-03-en",
      "title": "My trees",
      "steps": [
        {
          "goto": "/login"
        },
        {
          "wait": "input[type=tel]"
        },
        {
          "fill": [
            "input[type=tel]",
            "0700 000 012"
          ]
        },
        {
          "click": "button[type=submit]"
        },
        {
          "wait": "input[name=code]"
        },
        {
          "eval": "(() => { const p = [...document.querySelectorAll('p')].find(e => /^\\d{6}$/.test(e.textContent.trim())); if (p) window.__code = p.textContent.trim(); })()"
        },
        {
          "eval": "(() => { const i = document.querySelector('input[name=code]'); const set = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; set.call(i, window.__code); i.dispatchEvent(new Event('input', { bubbles: true })); })()"
        },
        {
          "click": "button:has-text('Sign in')"
        },
        {
          "wait": "main h1"
        },
        {
          "pause": 1500
        }
      ],
      "callouts": [
        {
          "sel": "main h1",
          "note": "My trees \u2014 where signing in lands you.",
          "side": "right"
        },
        {
          "sel": "main a[href=\"/species\"]",
          "note": "Plant your first tree, if you have none yet.",
          "side": "left"
        }
      ],
      "note": "Reads the sign-in code off the page, which only works because SMS_PROVIDER=mock prints it there."
    }
  ]
}
